RNAV_WEB_ORIGIN=https://r-navigation.com
RNAV_CONSOLE_ORIGIN=https://console.r-navigation.com
RNAV_API_INTERNAL_URL=http://127.0.0.1:14090
RNAV_PUBLIC_SOURCE=snapshot
RNAV_PUBLIC_ROOT=/srv/rnav_public
PUBLICATION_REQUIRE_SIGNATURE=true
PUBLICATION_VERIFY_KEY_FILE=/etc/rnav/publication-verify.pem
GATEWAY_TOKEN_FILE=/etc/rnav/gateway_token
