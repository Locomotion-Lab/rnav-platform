[Unit]
Description=RNAV Replaced Image Cleanup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=rnav
WorkingDirectory=/srv/rnav/current
EnvironmentFile=/etc/rnav/backend.env
ExecStart=/opt/rnav/node/bin/node --import tsx scripts/media/prune-replaced-images.ts
NoNewPrivileges=true
