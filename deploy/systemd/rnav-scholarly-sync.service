[Unit]
Description=RNAV Faculty Publication Candidate Sync
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=rnav
WorkingDirectory=/srv/rnav/current
EnvironmentFile=/etc/rnav/backend.env
ExecStart=/opt/rnav/node/bin/node --import tsx scripts/scholarly/sync-publications.ts
NoNewPrivileges=true
