FROM node:24.18.0-bookworm-slim AS runtime
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/publication packages/publication
RUN npm ci --omit=dev --workspace server --include-workspace-root --no-audit --no-fund
FROM postgres:14-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends age rsync openssh-client && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=runtime /app/node_modules ./node_modules
COPY --from=runtime /app/packages ./packages
COPY package.json ./
COPY scripts/phase3 ./scripts/phase3
ENTRYPOINT ["node","scripts/phase3/service-entry.mjs"]
CMD ["node","scripts/phase3/db-transfer.mjs"]
