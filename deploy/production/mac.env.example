# Operator-owned 0600 file; no secret values here. Same file used for every lifecycle command.
RNAV_BACKEND_IMAGE=rnav-backend:phase3
RNAV_DB_IMAGE=postgres:14-bookworm
RNAV_MAC_API_PORT=14090
RNAV_WEB_ORIGIN=https://r-navigation.com
COOKIE_SECURE=true
BACKEND_WRITE_ENABLED=false
RNAV_SECRETS_DIR=/Users/aaron/.config/rnav/secrets
RNAV_BACKUP_DIR=/Users/aaron/Projects/rnav-platform/backups/production-transfer
# Set only after approval of an independent encrypted backup directory/account.
RNAV_BACKUP_HOST=rnav-backup
AGE_RECIPIENT=
