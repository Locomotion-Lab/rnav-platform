limit_req_zone $binary_remote_addr zone=rnav_login:10m rate=10r/m;
# Candidate only: production still uses the phase-1 unified service. Requires explicit cutover approval.
server {
    listen 80;
    listen [::]:80;
    server_name r-navigation.com www.r-navigation.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name r-navigation.com www.r-navigation.com;

    ssl_certificate /etc/nginx/r-navigation.com_bundle.crt;
    ssl_certificate_key /etc/nginx/r-navigation.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    if ($host = www.r-navigation.com) { return 308 https://r-navigation.com$request_uri; }
    client_max_body_size 22m;

    location ~ ^/api/(v1/)?auth/login$ {
        limit_req zone=rnav_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host r-navigation.com;
        proxy_set_header X-Forwarded-Host r-navigation.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Rnav-Gateway-Token "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Rnav-Gateway-Token "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
