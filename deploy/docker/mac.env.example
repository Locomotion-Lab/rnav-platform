# Copy to repository root as .env.mac (ignored); use --env-file .env.mac.
# Use URL-safe random hex for password (DATABASE_URL interpolation).
POSTGRES_PASSWORD=
SESSION_SECRET=
PASSWORD_PEPPER=
PUBLIC_BASE_URL=http://127.0.0.1:14090
COOKIE_SECURE=false
SCHOLARLY_SYNC_ENABLED=false
# Optional: isolated COS bucket/prefix only during rehearsal.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PUBLIC_BASE_URL=
COS_PATH_PREFIX=rnav-rehearsal
# Compose defaults to local volume storage; old COS rows retain their original provider.
STORAGE_PROVIDER=local
STORAGE_ROOT=/data/private-media
