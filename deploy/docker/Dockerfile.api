FROM node:24.18.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY server/package.json server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/publication packages/publication
RUN npm ci --workspace server --include-workspace-root --no-audit --no-fund
COPY server server
RUN npm run build --workspace server
RUN cp -R server/db/migrations server/dist/db/migrations
RUN npm prune --omit=dev --workspace server --include-workspace-root --no-audit --no-fund

FROM node:24.18.0-bookworm-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4090
WORKDIR /app
# Keep the locked workspace dependency tree for tsx migration and scholarly jobs.
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package*.json ./
COPY --from=build --chown=node:node /app/server ./server
COPY --from=build --chown=node:node /app/packages ./packages
COPY scripts/scholarly ./scripts/scholarly
COPY scripts/publication ./scripts/publication
COPY scripts/phase3 ./scripts/phase3
RUN mkdir -p /data/private-media /data/publications && chown -R node:node /data
USER node
EXPOSE 4090
CMD ["node", "server/dist/index.js"]
